# --- Supabase (acceso al sistema) ---
# Sin estas dos la app arranca en modo demostración: la sesión vive en el
# navegador y el acceso con Google abre la demo en lugar de autenticar.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...            # SOLO servidor

# --- Stripe ---
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CONNECT_CLIENT_ID=ca_...

# --- Mercado Pago ---
MERCADOPAGO_ACCESS_TOKEN=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=

# --- OAuth calendarios ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
OAUTH_TOKEN_ENCRYPTION_KEY=                 # 32 bytes en base64 (openssl rand -base64 32)

# --- Google Analytics 4 (panel de marketing) ---
# Cuenta de servicio con permiso de lectura en la propiedad GA4. La clave
# privada se pega tal cual, con los saltos de línea escapados como \n.
GA4_PROPERTY_ID=                            # sólo el número, sin "properties/"
GOOGLE_SERVICE_ACCOUNT_EMAIL=               # ...@....iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=         # "-----BEGIN PRIVATE KEY-----\n..."

# --- Google Ads (panel de marketing) ---
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=                     # ID de la cuenta, con o sin guiones
GOOGLE_ADS_LOGIN_CUSTOMER_ID=               # sólo si se accede desde una MCC
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_API_VERSION=v24                  # opcional; por defecto v24
GOOGLE_ADS_CURRENCY=MXN                     # opcional; moneda de la cuenta

# --- Meta Ads (adaptador declarado, apagado por defecto) ---
META_ADS_ACCOUNT_ID=
META_ADS_ACCESS_TOKEN=

# --- Antibots / OTP / Rate limiting ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
